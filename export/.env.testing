# Laravel loads this file instead of .env when APP_ENV is testing (phpunit.xml
# sets it), so it has to stand on its own - nothing falls back to .env.
APP_NAME="Kit Dummy"
APP_ENV=testing
# A throwaway key: this environment only ever holds test data.
APP_KEY=base64:5u7bZRgtd/IvrxY83KZnNb7Kdim35jchfITEdbSjnxw=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=4

# Its own database, "<the site's database>_testing": the tests migrate and wipe
# it (RefreshDatabase). PostgreSQL is required, not just convention: the kit's
# migrations switch the users table to uuid ids, which SQLite cannot do.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kit_dummy_testing
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# Pro is needed for the second site; no license key, that is fine locally.
STATAMIC_PRO_ENABLED=true
STATAMIC_STACHE_WATCHER=false
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_TWO_FACTOR_ENABLED=false

# No Bunny credentials here: anything touching the main asset container fails,
# the same way it does locally.
GLIDE_CACHE_DISK=false

DEBUGBAR_ENABLED=false
