APP_NAME="Kit Dummy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Entries, trees, globals, terms and users live in the database (statamic/eloquent-driver).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The alt-text addon and static-cache warming queue jobs: redis + a running worker (Horizon).
QUEUE_CONNECTION=redis
HORIZON_MEMORY_LIMIT=256

CACHE_STORE=file
#CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STATAMIC_LICENSE_KEY=
# Pro is needed for multi-site or more than one user.
STATAMIC_PRO_ENABLED=false
STATAMIC_STACHE_WATCHER=auto
# half or full in production; the invalidator (app/StaticCaching) follows the content graph.
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_TWO_FACTOR_ENABLED=true
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GIT_ENABLED=false

DEBUGBAR_ENABLED=false

# Asset container + Glide cache on Bunny Storage, served through Bunny CDN.
BUNNY_S3_KEY=
BUNNY_S3_SECRET=
BUNNY_S3_REGION=de
BUNNY_S3_BUCKET=
BUNNY_S3_ENDPOINT=
BUNNY_PUBLIC_URL=
# Disk for generated Glide images (false = serve through the /img route)
GLIDE_CACHE_DISK=false

# Alt texts for image assets (el-schneider/statamic-auto-alt-text, queued)
ANTHROPIC_API_KEY=
AUTO_ALT_TEXT_MODEL=anthropic/claude-sonnet-4-5

BENTO_PUBLISHABLE_KEY=
BENTO_SECRET_KEY=
BENTO_SITE_UUID=
